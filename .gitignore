# Everything the installer fetches or the app produces. The repository is the
# source, not the install: a clone plus install.bat must reproduce a working
# copy, and nothing that changes when the app merely runs belongs in history.
.venv/
.venv-dlc/
tools/ffmpeg/
# uv.exe is ~65 MB and bootstrap_tools.ps1 downloads it, so it has no place in
# source history. The old pattern was "tools/uv*", which does not match
# "tools/bin/uv.exe" -- gitignore patterns containing no slash match a
# basename anywhere, but one with a slash is anchored, so "tools/uv*" only
# ever matched files directly inside tools/. The binary was tracked in all
# ten commits as a result.
tools/bin/
tools/uv*
__pycache__/
*.py[cod]

# Runtime state: recordings, sidecars, logs, exports, caches.
data/

# The operator's own settings. default_settings.json is tracked; this is not,
# so a pull never overwrites the camera and path settings of a working rig.
config/settings.json

# OS and editor noise
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
